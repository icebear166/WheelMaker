<!-- Shine sweep with a rest at the end of each pass: the band is fully off
     the mark at both ends, so the restart jump is invisible. -->
<objectAnimator xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="2100"
    android:startOffset="780"
    android:interpolator="@android:interpolator/accelerate_decelerate"
    android:repeatCount="infinite"
    android:repeatMode="restart">
    <propertyValuesHolder
        android:propertyName="translateX"
        android:valueType="floatType">
        <keyframe android:fraction="0" android:value="-940"/>
        <keyframe android:fraction="0.55" android:value="940"/>
        <keyframe android:fraction="1" android:value="940"/>
    </propertyValuesHolder>
</objectAnimator>
